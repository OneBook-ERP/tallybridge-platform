# TallyBridge Cloud — Environment Variables
# Copy to .env and fill in values before running

# ─── Server ───────────────────────────────────────────
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# ─── PostgreSQL ────────────────────────────────────────
DATABASE_URL=postgres://tallybridge:tallybridge_dev@localhost:5432/tallybridge

# ─── Redis ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── JWT / Machine Token ───────────────────────────────
# Generate: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_BEFORE_PRODUCTION_USE_openssl_rand_base64_48

# ─── ERPNext ───────────────────────────────────────────
ERPNEXT_URL=https://tally.zenpivot.in
ERPNEXT_API_KEY=your_api_key_here
ERPNEXT_API_SECRET=your_api_secret_here

# ─── ERPNext Webhook HMAC ──────────────────────────────
ERPNEXT_WEBHOOK_SECRET=CHANGE_ME

# ─── Connector (Live Testing) ──────────────────────────
# Set TALLY_ADDR in connector process env to override localhost:9000
# TALLY_ADDR=http://192.168.1.10:9000
