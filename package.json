{
  "name": "tallybridge-platform",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:cloud": "npm run dev --workspace=apps/cloud",
    "build:cloud": "npm run build --workspace=apps/cloud",
    "migrate": "npm run migrate --workspace=apps/cloud",
    "test": "npm test --workspace=apps/cloud",
    "lint": "eslint apps/cloud/src",
    "lint:fix": "eslint apps/cloud/src --fix",
    "format": "prettier --write 'apps/cloud/src/**/*.ts'",
    "format:check": "prettier --check 'apps/cloud/src/**/*.ts'"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "@typescript-eslint/parser": "^8.57.0",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.1"
  }
}
